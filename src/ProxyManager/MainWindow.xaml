<Window x:Class="ProxyManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ProxyManager.ViewModels"
        xmlns:local="clr-namespace:ProxyManager"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Proxy Manager" Width="980" Height="640" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: status + start/stop -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Применить изменения" Margin="0,0,8,0" Command="{Binding ApplyCommand}"
                            Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Параметры прокси изменились — перезапустить ядро. Активные соединения будут разорваны." />
                    <Button Style="{StaticResource AccentButton}" MinWidth="120"
                            Content="{Binding ToggleText}" Command="{Binding ToggleCoreCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Starting">
                                        <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                        <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Error banner -->
        <Border Grid.Row="1" Background="{StaticResource ErrorSurfaceBrush}" BorderBrush="{StaticResource ErrorBrush}"
                BorderThickness="0,0,0,1" Padding="16,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Padding="8,0" MinHeight="0" Background="Transparent"
                        BorderThickness="0" Command="{Binding DismissErrorCommand}" />
                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" Margin="12" Padding="12">
            <!-- Programs -->
            <TabItem Header="Программы">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Выбрать .exe…" Click="AddExe_Click" Margin="0,0,8,0" />
                        <Button Content="+ Из запущенных…" Click="AddFromRunning_Click" />
                    </StackPanel>
                    <Grid>
                        <DataGrid x:Name="RulesGrid" ItemsSource="{Binding Rules}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}" BorderBrush="{StaticResource BorderBrush}"
                                  Background="White" RowHeight="44" SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Вкл" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Программа" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ExePath}">
                                                <Image Source="{Binding Icon}" Width="24" Height="24" Margin="4,0,10,0" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ExePath}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Дочерние"
                                                   ToolTip="Пускать через тот же прокси программы, которые запускает эта программа (например, claude.exe из VS Code)" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IncludeChildren, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Прокси" Width="240">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox VerticalAlignment="Center" Margin="0,0,8,0"
                                                      ItemsSource="{Binding DataContext.Proxies, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      SelectedValue="{Binding ProxyId, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" ToolTip="Удалить" Padding="6,0" MinHeight="24" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"
                                   TextAlignment="Center" IsHitTestVisible="False"
                                   Text="Добавьте программу, которую нужно пустить через прокси.">
                            <TextBlock.Visibility>
                                <Binding Path="HasItems" ElementName="RulesGrid">
                                    <Binding.Converter>
                                        <local:InverseBoolToVisibilityConverter />
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Proxies -->
            <TabItem Header="Прокси">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="Добавить" Command="{Binding AddProxyCommand}" Margin="0,0,6,0" />
                            <Button Content="Удалить" Command="{Binding RemoveProxyCommand}" Margin="0,0,6,0" />
                            <Button Content="Проверить все" Command="{Binding CheckAllCommand}" />
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding Proxies}" SelectedItem="{Binding SelectedProxy}"
                                 BorderBrush="{StaticResource BorderBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,5">
                                        <Ellipse DockPanel.Dock="Left" Style="{StaticResource CheckDot}" Margin="0,0,10,0"
                                                 VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Type, Converter={StaticResource ProxyTypeText}, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding Address, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding CheckResult}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="Параметры прокси" Padding="12" Margin="0,0,0,12" DataContext="{Binding SelectedProxy}">
                                <GroupBox.Style>
                                    <Style TargetType="GroupBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </GroupBox.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Название" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="Тип" Style="{StaticResource FieldLabel}" Margin="12,0,12,0" />
                                    <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:MainViewModel.ProxyTypes}"
                                              SelectedItem="{Binding Type}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ProxyTypeText}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Text="Хост" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Порт" Style="{StaticResource FieldLabel}" Margin="12,0,12,0" />
                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="4" Text="Логин" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="6" Text="Пароль" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3"
                                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                                        <Button Content="Проверить" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.CheckProxyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Ellipse Style="{StaticResource CheckDot}" Margin="12,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CheckResult}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Импорт списком" Padding="12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8">
                                        По одному прокси на строку. Форматы:
                                        socks5://user:pass@host:port · http://host:port ·
                                        host:port:user:pass · user:pass@host:port · host:port
                                    </TextBlock>
                                    <TextBox Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                             Height="90" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas" TextWrapping="NoWrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Тип, если не указан в строке:" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Width="90" ItemsSource="{x:Static vm:MainViewModel.ProxyTypes}"
                                                  SelectedItem="{Binding ImportType}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource ProxyTypeText}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Импортировать" Command="{Binding ImportCommand}" Margin="12,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ImportStatus}" Margin="0,8,0,0" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Log -->
            <TabItem Header="Журнал">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Копировать" Command="{Binding CopyLogCommand}" Margin="0,0,8,0"
                                ToolTip="Скопировать журнал в буфер обмена, например чтобы отправить в поддержку" />
                        <Button Content="Очистить" Command="{Binding ClearLogCommand}" />
                    </StackPanel>
                    <ListBox x:Name="LogList" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12"
                             BorderBrush="{StaticResource BorderBrush}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                </DockPanel>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="Настройки">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <GroupBox Header="Запуск" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding StartWithWindows}" Content="Запускать вместе с Windows" />
                            <TextBlock Style="{StaticResource Hint}" Margin="20,2,0,10"
                                       Text="Программа стартует свёрнутой в область уведомлений, без запроса прав администратора." />
                            <CheckBox IsChecked="{Binding ConnectOnStartup}" Content="Включать прокси сразу после запуска программы" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="О программе" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <WrapPanel>
                                <Button Content="Папка настроек и логов" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                                <Button Content="Лицензии компонентов" Command="{Binding OpenLicensesCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
